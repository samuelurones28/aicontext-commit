{
  "name": "aicontext-commit",
  "version": "0.1.3",
  "description": "AI commit messages that match your team's style — learns from your git history. Works with Claude, OpenAI, or free local models via Ollama",
  "bin": {
    "aicontext-commit": "bin/index.js",
    "acc": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node bin/index.js",
    "test": "npm run build && node --test tests/*.test.js",
    "smoke": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "ai",
    "llm",
    "cli",
    "conventional-commits",
    "anthropic",
    "claude",
    "openai",
    "ollama",
    "local-llm",
    "aicommits",
    "opencommit",
    "git-commit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelurones28/aicontext-commit.git"
  },
  "author": "Samuelurones28",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@inquirer/input": "^2.3.0",
    "@inquirer/select": "^2.5.0",
    "dotenv": "^17.4.2",
    "openai": "^4.28.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/samuelurones28/aicontext-commit#readme",
  "bugs": {
    "url": "https://github.com/samuelurones28/aicontext-commit/issues"
  }
}
